# .env
GEOIP_CITY_DB=./data/GeoLite2-City.mmdb
GEOIP_ASN_DB=./data/GeoLite2-ASN.mmdb
PORT=3000
LOG_LEVEL=debug # z.B. für mehr Details im Development
PING_COUNT=4
# NODE_ENV=development # Setze dies ggf. für pino-pretty
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=300000 # 5 Minuten

# --- Diagnose-Seite: Echo-Endpoint (Latenz/Jitter/Paketverlust) ---
ECHO_RATE_LIMIT_MAX=400          # Ein Testlauf feuert ca. 40 Requests
ECHO_RATE_LIMIT_WINDOW_MS=60000  # 1 Minute

# --- Diagnose-Seite: Speedtest (Down-/Upload Durchsatz) ---
# Standardmäßig deaktiviert (Opt-in) — nicht jeder Self-Hoster möchte Bandbreite dafür bereitstellen
SPEEDTEST_ENABLED=false
SPEEDTEST_MAX_DOWNLOAD_MB=25
SPEEDTEST_MAX_UPLOAD_MB=25
SPEEDTEST_RATE_LIMIT_MAX=10           # Bandbreiten-intensiv -> enges Limit
SPEEDTEST_RATE_LIMIT_WINDOW_MS=600000 # 10 Minuten